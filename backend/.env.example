# RockSafe backend configuration — copy to .env and adjust as needed.
# SQLite (default, zero-config):
ROCKSAFE_DATABASE_URL=sqlite:///./rocksafe.db
# PostgreSQL (production/Docker):
# ROCKSAFE_DATABASE_URL=postgresql://rocksafe:rocksafe@localhost:5432/rocksafe

# Optional MQTT broker (leave empty to disable the publisher):
ROCKSAFE_MQTT_URL=
ROCKSAFE_MQTT_TOPIC=rocksentinel/predictions

# CORS origins allowed to call the API directly (Vite dev server):
ROCKSAFE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
